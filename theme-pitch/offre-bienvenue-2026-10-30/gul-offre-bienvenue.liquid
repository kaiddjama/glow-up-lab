{%- comment -%}
  Offre de bienvenue WELCOME10 : rendue visible partout (30 oct.).
  - Accueil : bandeau bordeaux sous les bannières.
  - Fiche produit : carte « -10 % » au-dessus du bloc livraison.
  - Panier (tiroir) : carte au-dessus du total, masquée si le code est déjà appliqué.
  - Le lien « J'en profite » passe par /discount/WELCOME10, qui applique le code à la commande.
  - Bouton « Copier » : copie le code.
  Retour arrière : retirer {% render 'gul-offre-bienvenue' %} de snippets/gul-stock-default.liquid.
{%- endcomment -%}
{%- assign gul_en = false -%}
{%- if request.locale.iso_code contains 'en' -%}{%- assign gul_en = true -%}{%- endif -%}
{%- unless template contains 'password' or template contains 'customers' -%}
<template id="gul-offre-band">
  <section class="gul-offre gul-offre--band" aria-label="{% if gul_en %}Welcome offer{% else %}Offre de bienvenue{% endif %}">
    <p class="gul-offre__eyebrow">{% if gul_en %}Welcome gift{% else %}Cadeau de bienvenue{% endif %}</p>
    <p class="gul-offre__title">{% if gul_en %}10% off your first order{% else %}-10 % sur votre première commande{% endif %}</p>
    <p class="gul-offre__sub">{% if gul_en %}With the code <b class="gul-offre__code">WELCOME10</b>. One use, for new customers.{% else %}Avec le code <b class="gul-offre__code">WELCOME10</b>. Valable une fois, pour les nouvelles clientes.{% endif %}</p>
    <div class="gul-offre__actions">
      <a class="gul-offre__cta" href="/discount/WELCOME10?redirect=/collections/best-sellers">{% if gul_en %}Use my 10%{% else %}J'en profite{% endif %}</a>
      <button type="button" class="gul-offre__copy" data-gul-offre-copy>{% if gul_en %}Copy code{% else %}Copier le code{% endif %}</button>
    </div>
  </section>
</template>
<template id="gul-offre-card">
  <div class="gul-offre gul-offre--card" role="note">
    <span class="gul-offre__badge" aria-hidden="true">-10%</span>
    <span class="gul-offre__body">
      <strong>{% if gul_en %}10% off your first order{% else %}-10 % sur votre première commande{% endif %}</strong>
      <span>{% if gul_en %}Code{% else %}Code{% endif %} <b class="gul-offre__code">WELCOME10</b></span>
    </span>
    <button type="button" class="gul-offre__copy" data-gul-offre-copy>{% if gul_en %}Copy{% else %}Copier{% endif %}</button>
  </div>
</template>

<style>
  .gul-offre { --gul-bordeaux: #701C32; --gul-bordeaux-fonce: #551425; --gul-creme: #F6F1EB; --gul-sable: #E8DCCF; --gul-cacao: #5A4136; box-sizing: border-box; }
  .gul-offre__code { letter-spacing: 0.06em; font-weight: 600; }
  .gul-offre__copy { font: inherit; font-size: 13px; cursor: pointer; border-radius: 100px; padding: 9px 16px; min-height: 40px; background: transparent; border: 1px solid currentColor; color: inherit; white-space: nowrap; }
  .gul-offre__copy:focus-visible, .gul-offre__cta:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

  .gul-offre--band { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 36px 20px; text-align: center; background: var(--gul-bordeaux); color: var(--gul-creme); }
  .gul-offre--band p { margin: 0; }
  .gul-offre--band .gul-offre__eyebrow { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.85; }
  .gul-offre--band .gul-offre__title { font-size: clamp(24px, 4vw, 36px); line-height: 1.2; font-weight: 400; }
  .gul-offre--band .gul-offre__sub { font-size: 14px; line-height: 1.5; opacity: 0.92; }
  .gul-offre--band .gul-offre__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 12px; }
  .gul-offre__cta { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 9px 22px; border-radius: 100px; font-size: 14px; font-weight: 500; text-decoration: none; background: var(--gul-creme); color: var(--gul-bordeaux); }
  .gul-offre__cta:hover { background: var(--gul-sable); }

  .gul-offre--card { display: flex; align-items: center; gap: 12px; width: 100%; margin: 0 0 14px; padding: 12px 14px; border: 1px dashed var(--gul-bordeaux); border-radius: 14px; background: var(--gul-sable); color: #1E1A17; font-size: 13px; line-height: 1.35; }
  .gul-offre--card .gul-offre__badge { flex: none; display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; background: var(--gul-bordeaux); color: var(--gul-creme); font-size: 13px; font-weight: 500; }
  .gul-offre--card .gul-offre__body { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .gul-offre--card .gul-offre__body strong { font-weight: 500; color: var(--gul-bordeaux); }
  .gul-offre--card .gul-offre__copy { color: var(--gul-bordeaux); border-color: var(--gul-bordeaux); }
  .gul-offre--cart { width: auto; margin: var(--padding-lg, 16px) var(--cart-drawer-padding, 20px) 0; }

  /* Barre d'annonce : texte lisible sur deux lignes sur mobile */
  .announcement-bar__slide { --line-height: 1.3 !important; }
  .announcement-bar__text strong { font-weight: 600; letter-spacing: 0.02em; }
</style>

<script>
  (function () {
    var TEMPLATE = {{ template.name | json }};
    var CODE = 'WELCOME10';

    function clone(id) {
      var t = document.getElementById(id);
      return t && t.content && t.content.firstElementChild ? t.content.firstElementChild.cloneNode(true) : null;
    }

    function placeHome() {
      if (TEMPLATE !== 'index' || document.querySelector('.gul-offre--band')) return;
      var band = clone('gul-offre-band');
      if (!band) return;
      var after = document.querySelector('[id$="__ban_m"]');
      var before = document.querySelector('[id$="__brands"]');
      if (after) after.insertAdjacentElement('afterend', band);
      else if (before) before.parentNode.insertBefore(band, before);
    }

    function placeProduct() {
      if (!document.querySelector('[data-gul-delivery]') || document.querySelector('.gul-offre--product')) return;
      var box = document.querySelector('[data-gul-delivery]');
      var card = clone('gul-offre-card');
      if (!card) return;
      card.classList.add('gul-offre--product');
      box.parentNode.insertBefore(card, box);
    }

    function ensureCart() {
      var summary = document.querySelector('#cart-drawer .cart-drawer__summary');
      if (!summary || !summary.parentNode) return;
      var current = summary.parentNode.querySelector(':scope > .gul-offre--cart');
      var applied = new RegExp(CODE, 'i').test(summary.textContent || '');
      if (applied) { if (current) current.remove(); return; }
      if (current) return;
      var card = clone('gul-offre-card');
      if (!card) return;
      card.classList.add('gul-offre--cart');
      summary.parentNode.insertBefore(card, summary);
    }

    function copy(button) {
      var done = function () {
        var old = button.getAttribute('data-label') || button.textContent;
        button.setAttribute('data-label', old);
        button.textContent = {% if gul_en %}'Copied'{% else %}'Copié'{% endif %};
        window.setTimeout(function () { button.textContent = old; }, 2000);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(CODE).then(done, function () { fallback(done); });
      } else {
        fallback(done);
      }
    }
    function fallback(done) {
      var field = document.createElement('textarea');
      field.value = CODE;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      try { document.execCommand('copy'); } catch (e) {}
      field.remove();
      done();
    }

    document.addEventListener('click', function (event) {
      var button = event.target.closest && event.target.closest('[data-gul-offre-copy]');
      if (button) { event.preventDefault(); copy(button); }
    });

    function init() {
      placeHome();
      placeProduct();
      ensureCart();
      var drawer = document.getElementById('cart-drawer');
      if (drawer && 'MutationObserver' in window) {
        var queued = false;
        new MutationObserver(function () {
          if (queued) return;
          queued = true;
          window.requestAnimationFrame(function () { queued = false; ensureCart(); });
        }).observe(drawer, { childList: true, subtree: true });
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
{%- endunless -%}
