{%- doc -%}
  Aimé Essentials : une rubrique du menu mobile en accordéon « + » (comme les autres), dont les rayons sont regroupés
  en sous-accordéons « + » (ex. Maquillage : Teint, Joues et éclat, Lèvres, Yeux).
  Les rayons viennent du menu principal : un rayon absent des groupes s'affiche seul en fin de liste.

  @param {object} link - La rubrique du menu (avec ses sous-liens)
  @param {string} groupes - Groupes : « Titre|handle,handle;Titre|handle,handle »
{%- enddoc -%}
{%- liquid
  assign gul_groupes = groupes | split: ';'
  assign gul_deja = ','
  for gul_groupe in gul_groupes
    assign gul_h = gul_groupe | split: '|' | last
    assign gul_deja = gul_deja | append: gul_h | append: ','
  endfor
-%}
{% capture gul_accordeon %}
  <details id="Details-menu-drawer-{{ link.handle }}">
    <summary
      id="HeaderDrawer-{{ link.handle }}"
      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
    >
      <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>
    <ul
      class="menu-drawer__menu menu-drawer__menu--childlist menu-drawer__animated-element details-content"
      role="list"
      tabindex="-1"
    >
      <li class="menu-drawer__list-item" style="--menu-drawer-animation-index: 1;">
        <a
          href="{{ link.url }}"
          class="menu-drawer__menu-item menu-drawer__menu-item--child{% if link.current %} menu-drawer__menu-item--active{% endif %}"
        >
          <span class="menu-drawer__menu-item-text wrap-text">Tout voir</span>
        </a>
      </li>

      {%- for gul_groupe in gul_groupes -%}
        {%- assign gul_titre = gul_groupe | split: '|' | first -%}
        {%- assign gul_handles = gul_groupe | split: '|' | last | split: ',' -%}
        <li class="menu-drawer__list-item" style="--menu-drawer-animation-index: {{ forloop.index | plus: 1 }};">
          <details class="gul-rubrique__details">
            <summary class="menu-drawer__menu-item menu-drawer__menu-item--child gul-rubrique__row">
              <span class="menu-drawer__menu-item-text wrap-text">{{ gul_titre }}</span>
              <span class="gul-rubrique__plus" aria-hidden="true"></span>
            </summary>
            <ul class="gul-rubrique__sous" role="list">
              {%- for gul_h in gul_handles -%}
                {%- assign gul_url = '/collections/' | append: gul_h -%}
                {%- for sub in link.links -%}
                  {%- if sub.url == gul_url -%}
                    <li>
                      <a
                        href="{{ sub.url }}"
                        class="gul-rubrique__sous-lien{% if sub.current %} gul-rubrique__sous-lien--actif{% endif %}"
                        {% if sub.current %}aria-current="page"{% endif %}
                      >{{ sub.title | escape }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </ul>
          </details>
        </li>
      {%- endfor -%}

      {%- for sub in link.links -%}
        {%- assign gul_cle = ',' | append: sub.url | remove: '/collections/' | append: ',' -%}
        {%- assign gul_groupe_deja = false -%}
        {%- if gul_deja contains gul_cle -%}{%- assign gul_groupe_deja = true -%}{%- endif -%}
        {%- if sub.url != link.url and gul_groupe_deja == false -%}
          <li class="menu-drawer__list-item">
            <a
              href="{{ sub.url }}"
              class="menu-drawer__menu-item menu-drawer__menu-item--child{% if sub.current %} menu-drawer__menu-item--active{% endif %}"
              {% if sub.current %}aria-current="page"{% endif %}
            >
              <span class="menu-drawer__menu-item-text wrap-text">{{ sub.title | escape }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </details>
{% endcapture %}
{% render 'accordion-custom-component', children: gul_accordeon %}

{% stylesheet %}
  .gul-rubrique__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  .gul-rubrique__row::-webkit-details-marker {
    display: none;
  }

  .gul-rubrique__plus::before {
    content: '+';
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1;
  }

  .gul-rubrique__details[open] .gul-rubrique__plus::before {
    content: '\2212';
  }

  .gul-rubrique__sous {
    margin: 0;
    padding: 0 0 8px 16px;
    list-style: none;
  }

  .gul-rubrique__sous-lien {
    display: block;
    padding-block: 8px;
    font-size: 0.9375rem;
    color: inherit;
    text-decoration: none;
  }

  .gul-rubrique__sous-lien--actif {
    font-weight: 500;
  }
{% endstylesheet %}
