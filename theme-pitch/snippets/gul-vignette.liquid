{%- doc -%}
  Aimé Essentials : petite photo d'une rubrique = le premier produit disponible de la collection (photo réelle du produit).

  @param {string} handle - Le handle de la collection
{%- enddoc -%}
{%- assign gul_collection = collections[handle] -%}
{%- assign gul_produit = gul_collection.products | where: 'available' | first -%}
{%- if gul_produit.featured_image -%}
  {{ gul_produit.featured_image | image_url: width: 160 | image_tag: width: 56, height: 56, alt: '', loading: 'lazy', class: 'gul-rubrique__vignette' }}
{%- else -%}
  <span class="gul-rubrique__vignette"></span>
{%- endif -%}
